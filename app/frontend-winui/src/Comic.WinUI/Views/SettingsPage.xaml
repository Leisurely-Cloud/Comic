<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Comic_WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24" MaxWidth="700" HorizontalAlignment="Left">
        <StackPanel Spacing="16">
            <TextBlock Text="应用设置" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Connection Settings -->
            <Border Padding="16" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="后端连接" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox Header="后端地址"
                             Text="{x:Bind ViewModel.BackendBaseUrl, Mode=TwoWay}"
                             PlaceholderText="http://127.0.0.1:18765/" />
                    <TextBox Header="Python 可执行文件"
                             Text="{x:Bind ViewModel.PythonExecutablePath, Mode=TwoWay}"
                             PlaceholderText="python" />
                    <TextBox Header="启动参数"
                             Text="{x:Bind ViewModel.PythonArguments, Mode=TwoWay}"
                             PlaceholderText="-m backend.api" />
                    <TextBox Header="工作目录"
                             Text="{x:Bind ViewModel.WorkingDirectory, Mode=TwoWay}"
                             PlaceholderText="留空使用默认" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SaveCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock Text="保存" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.RefreshBackendInfoCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backend Info -->
            <Border Padding="16" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="后端信息" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="存储根目录" Opacity="0.6" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Bind ViewModel.StorageRoot, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="旧版目录" Opacity="0.6" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{x:Bind ViewModel.LegacyRoot, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="下载器" Opacity="0.6" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{x:Bind ViewModel.DownloadRunnerStatus, Mode=OneWay}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="支持站点" Opacity="0.6" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{x:Bind ViewModel.SupportedSites, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="12" CornerRadius="8"
                    Visibility="{x:Bind ViewModel.SettingsError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE783;" Foreground="Tomato" VerticalAlignment="Center" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.SettingsError, Mode=OneWay}"
                               Foreground="Tomato" TextWrapping="WrapWholeWords"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
