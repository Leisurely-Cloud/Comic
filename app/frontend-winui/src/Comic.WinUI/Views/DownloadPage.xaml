<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Comic.WinUI.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Comic.WinUI.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="WorkspaceToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="126" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Width="250" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="找漫画" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="输入 JM 编号、链接或关键词找到漫画，勾选章节后创建下载任务。"
                           Style="{StaticResource PageDescriptionTextBlockStyle}" />
            </StackPanel>
            <Border Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="4"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="DiscoveryWorkspaceTab"
                                  Style="{StaticResource WorkspaceToggleButtonStyle}"
                                  IsChecked="True"
                                  Click="OnWorkspaceTabClick">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                            <TextBlock Text="搜索与选章" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="TasksWorkspaceTab"
                                  Style="{StaticResource WorkspaceToggleButtonStyle}"
                                  Click="OnWorkspaceTabClick">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock Text="下载任务" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CompactCardBorderStyle}"
                    VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.TaskCountSummary, Mode=OneWay}"
                           FontSize="12" Opacity="0.75" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid x:Name="DiscoveryWorkspace" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:SearchBarControl x:Name="SearchBarControl1"
                                           ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

                <Grid Grid.Row="1" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                    </Grid.ColumnDefinitions>

                    <controls:SearchResultsList Grid.Column="0"
                                                ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                    <controls:MangaSelectionPanel Grid.Column="1"
                                                  ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                                  DownloadStarted="OnDownloadStarted"
                                                  OnlineReadRequested="OnOnlineReadRequested" />
                </Grid>
            </Grid>

            <controls:TaskListPanel x:Name="TaskWorkspace"
                                    Visibility="Collapsed"
                                    ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
