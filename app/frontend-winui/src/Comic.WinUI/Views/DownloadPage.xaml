<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Comic_WinUI.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Comic.WinUI.Models"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" Padding="20,16" CornerRadius="12" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="14">
                <!-- Title + Backend buttons -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="搜索下载" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="选择站点，输入漫画名称搜索，选择后开始下载。"
                                   Opacity="0.6" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.EnsureBackendRunningCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="启动后端" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.RefreshBackendCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- Search inputs -->
                <Grid ColumnSpacing="12" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Header="站点"
                              VerticalAlignment="Bottom"
                              ItemsSource="{x:Bind ViewModel.SiteOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedSite, Mode=TwoWay}" />
                    <TextBox Grid.Column="1" Header="漫画名称"
                             PlaceholderText="输入关键词搜索..."
                             Text="{x:Bind ViewModel.SearchKeyword, Mode=TwoWay}" />
                    <Button Grid.Column="2" VerticalAlignment="Bottom" MinWidth="90"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SearchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                            <TextBlock Text="搜索" />
                        </StackPanel>
                    </Button>
                </Grid>
                <!-- Error message -->
                <TextBlock Text="{x:Bind ViewModel.PageError, Mode=OneWay}"
                           Foreground="Tomato" TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,12,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Left: Search Results -->
            <Border Grid.Column="0" Padding="16" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                        <TextBlock Text="搜索结果" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SearchStatusText, Mode=OneWay}"
                                   Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Visibility="{x:Bind ViewModel.IsSearching, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                    Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                            <ProgressRing IsActive="True" Width="16" Height="16" />
                            <TextBlock Text="搜索中..." Opacity="0.7" VerticalAlignment="Center" />
                        </StackPanel>
                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSearchResult, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:SearchResultItemViewModel"
                                          xmlns:viewModels="using:Comic_WinUI.ViewModels">
                                <Grid Padding="8,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="48" Height="64" CornerRadius="4"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                                        <Image Stretch="UniformToFill">
                                            <Image.Source>
                                                <BitmapImage UriSource="{x:Bind CoverUrl}" DecodePixelWidth="48" />
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind LatestChapter}" Opacity="0.6" FontSize="12" />
                                            <TextBlock Text="{x:Bind UpdateTime}" Opacity="0.4" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" Opacity="0.3"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: Detail + Chapters + Tasks -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Manga Detail Card -->
                <Border Grid.Row="0" Padding="16" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <TextBlock Text="漫画详情" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <!-- Empty state -->
                                <StackPanel Visibility="{x:Bind ViewModel.HasManga, Converter={StaticResource InvertBoolToVisibilityConverter}, Mode=OneWay}"
                                            Padding="0,20" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="28" HorizontalAlignment="Center" Opacity="0.4" />
                                    <TextBlock Text="搜索并选择一部漫画查看详情" Opacity="0.5" HorizontalAlignment="Center" />
                                </StackPanel>
                                <!-- Cover Image -->
                                <Border Height="120" CornerRadius="6" HorizontalAlignment="Left"
                                        Visibility="{x:Bind ViewModel.HasManga, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind ViewModel.CurrentManga.CoverUrl, Mode=OneWay}" DecodePixelHeight="120" />
                                        </Image.Source>
                                    </Image>
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.CurrentManga.Title, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextWrapping="WrapWholeWords" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="站点" Opacity="0.6" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentManga.SiteName, Mode=OneWay}" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="最新" Opacity="0.6" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentManga.LatestChapter, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.CurrentManga.DetailHint, Mode=OneWay}"
                                           TextWrapping="WrapWholeWords" Opacity="0.7" FontSize="12" />
                                <!-- Buttons: 2x2 grid to avoid cutoff -->
                                <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Command="{x:Bind ViewModel.StartDownloadCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                                            <TextBlock Text="开始下载" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Command="{x:Bind ViewModel.PauseCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE769;" FontSize="14" />
                                            <TextBlock Text="暂停" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            Command="{x:Bind ViewModel.ResumeCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            <TextBlock Text="继续" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            Command="{x:Bind ViewModel.StopCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                            <TextBlock Text="停止" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- Loading overlay -->
                        <Grid Visibility="{x:Bind ViewModel.IsResolving, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Opacity="0.85">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <ProgressRing IsActive="True" Width="32" Height="32" />
                                <TextBlock Text="正在获取漫画详情..." Opacity="0.7" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Chapter Selection -->
                <Border Grid.Row="1" Padding="16" CornerRadius="12" BorderThickness="1" Margin="0,12,0,0"
                        Visibility="{x:Bind ViewModel.ShowChapterSelection, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="章节选择"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.ChapterSelectionSummary, Mode=OneWay}"
                                       Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Command="{x:Bind ViewModel.SelectAllChaptersCommand}" Padding="8,4">
                                <TextBlock Text="全选" FontSize="12" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.DeselectAllChaptersCommand}" Padding="8,4">
                                <TextBlock Text="取消全选" FontSize="12" />
                            </Button>
                        </StackPanel>
                        <ScrollViewer Grid.Row="2" MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableChapters, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:ChapterItemViewModel"
                                                  xmlns:viewModels="using:Comic_WinUI.ViewModels">
                                        <CheckBox Content="{x:Bind Title}"
                                                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                  Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Task List -->
                <Border Grid.Row="2" Padding="16" CornerRadius="12" BorderThickness="1" Margin="0,12,0,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="下载任务"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TaskCountSummary, Mode=OneWay}"
                                       Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="1" Margin="0,8,0,0" Padding="10" CornerRadius="8"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind ViewModel.CurrentTask.StatusText, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.CurrentTask.ProgressText, Mode=OneWay}"
                                               Opacity="0.7" />
                                </Grid>
                                <ProgressBar Minimum="0" Maximum="100"
                                             Value="{x:Bind ViewModel.CurrentTask.Progress, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <ListView Grid.Row="2" Margin="0,8,0,0"
                                  ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.CurrentTask, Mode=TwoWay}"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:DownloadTaskItemViewModel"
                                              xmlns:viewModels="using:Comic_WinUI.ViewModels">
                                    <Grid Padding="4,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                            <TextBlock Text="{x:Bind LatestLogMessage}" Opacity="0.5"
                                                       TextTrimming="CharacterEllipsis" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Status}"
                                                   VerticalAlignment="Center" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ProgressText}"
                                                   VerticalAlignment="Center" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom: Log -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="10" MaxHeight="140"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="实时日志"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentTask.Status, Mode=OneWay}"
                               Opacity="0.6" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentTask.Logs, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DownloadLogEntry"
                                          xmlns:models="using:Comic.WinUI.Models">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                    <TextBlock Text="{x:Bind Time}" Opacity="0.5" FontSize="11" MinWidth="80" />
                                    <TextBlock Text="{x:Bind Tag}" Opacity="0.6" FontSize="11" MinWidth="40" />
                                    <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
