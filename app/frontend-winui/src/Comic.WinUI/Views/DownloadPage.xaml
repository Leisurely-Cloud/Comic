<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Comic.WinUI.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Comic.WinUI.Controls"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <controls:SearchBarControl x:Name="SearchBarControl1" Grid.Row="0" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

        <!-- Main Content: Search Results (left) + Task List (right) -->
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <Grid ColumnSpacing="16" MinWidth="640">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <controls:SearchResultsList Grid.Column="0" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                <controls:TaskListPanel Grid.Column="1" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
