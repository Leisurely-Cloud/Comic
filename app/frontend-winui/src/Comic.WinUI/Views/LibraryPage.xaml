<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Comic.WinUI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Comic.WinUI.Models"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + Search -->
        <Border Grid.Row="0" Style="{StaticResource HeaderCardBorderStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Width="170" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="我的书库" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PageSummary, Mode=OneWay}"
                                   Style="{StaticResource PageDescriptionTextBlockStyle}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" VerticalAlignment="Center"
                             PlaceholderText="按漫画名称或作者筛选书库"
                             Text="{x:Bind ViewModel.Keyword, Mode=TwoWay}" />
                    <Button Grid.Column="2" VerticalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SearchCommand, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                            <TextBlock Text="搜索" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.IsImporting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                            Click="OnImportJmClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE898;" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.ImportButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.RefreshLibraryCommand, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ComboBox Width="120" Header="状态" SelectedIndex="{x:Bind ViewModel.CompletionFilterIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="已完成" />
                        <ComboBoxItem Content="未完成" />
                    </ComboBox>
                    <CheckBox Content="仅收藏" IsChecked="{x:Bind ViewModel.FavoritesOnly, Mode=TwoWay}" VerticalAlignment="Bottom" />
                    <CheckBox Content="有更新" IsChecked="{x:Bind ViewModel.UpdatesOnly, Mode=TwoWay}" VerticalAlignment="Bottom" />
                    <ComboBox Width="140" Header="排序" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="最近阅读" />
                        <ComboBoxItem Content="下载时间" />
                        <ComboBoxItem Content="章节数" />
                    </ComboBox>
                    <TextBlock Text="{x:Bind ViewModel.PageError, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.PageError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Text="{x:Bind ViewModel.UpdateCheckStatus, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.UpdateCheckStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.LibraryStatus, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.LibraryStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Prominent export status -->
        <Border Grid.Row="1" Style="{StaticResource SettingsRowBorderStyle}"
                Visibility="{x:Bind ViewModel.ShowExportResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE7B7;" FontSize="18" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ExportStatusTitle, Mode=OneWay}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.ExportStatusText, Mode=OneWay}"
                               FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Content="打开输出目录"
                        Visibility="{x:Bind ViewModel.ExportOutputDirectory, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                        Command="{x:Bind ViewModel.OpenExportDirectoryCommand, Mode=OneWay}" />
                <Button Grid.Column="3" Content="取消"
                        Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Command="{x:Bind ViewModel.CancelExportCommand, Mode=OneWay}" />
                <Button Grid.Column="3" Content="完成"
                        Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                        Command="{x:Bind ViewModel.DismissExportResultCommand, Mode=OneWay}" />
                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                             Value="{x:Bind ViewModel.ExportProgress, Mode=OneWay}"
                             Maximum="100" Height="4"
                             Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2"
              ColumnSpacing="16"
              SizeChanged="OnLibraryContentSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Library List -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
                        <TextBlock Text="已下载漫画" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    </StackPanel>

                    <!-- Loading Indicator -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                      Width="48" Height="48"
                                      HorizontalAlignment="Center" />
                        <TextBlock Text="正在加载漫画库..."
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                                Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE8D1;" FontSize="48" Opacity="0.5"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="漫画库为空"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="下载漫画后将在此显示"
                                   FontSize="12" Opacity="0.6"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                              SelectionMode="Single"
                              Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:LibraryItemViewModel"
                                          xmlns:viewModels="using:Comic.WinUI.ViewModels">
                                <Grid Padding="8,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="48" Height="64">
                                    <Border CornerRadius="6"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE8F1;" FontSize="20" Opacity="0.35"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{x:Bind CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                   Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                        <Border CornerRadius="6"
                                                BorderThickness="2"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Border Width="20" Height="20"
                                                CornerRadius="10"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,-6,-6,0"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <FontIcon Glyph="&#xE734;" FontSize="11"
                                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Padding="7,2" CornerRadius="8"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <FontIcon Glyph="&#xE734;" FontSize="10"
                                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    <TextBlock Text="已收藏" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind AuthorDisplay, Mode=OneWay}"
                                                   Visibility="{x:Bind AuthorDisplay, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                                                   Opacity="0.8" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ContinueReadingText, Mode=OneWay}"
                                                   Visibility="{x:Bind ContinueReadingText, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                                                   Opacity="0.8" FontSize="12"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind SiteName, Mode=OneWay}" Opacity="0.7" FontSize="12" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind CompletionText, Mode=OneWay}" FontSize="11" Opacity="0.7" />
                                            <TextBlock Text="{x:Bind DiskUsageText, Mode=OneWay}" FontSize="11" Opacity="0.7" />
                                            <TextBlock Text="{x:Bind MangaIdText, Mode=OneWay}" FontSize="11" Opacity="0.7"
                                                       Visibility="{x:Bind MangaIdText, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind DuplicateDirectoriesText, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{x:Bind HasDuplicateDirectories, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" Opacity="0.5"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="上一页" Padding="14,6"
                                IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PreviousPageCommand, Mode=OneWay}" />
                        <Border Grid.Column="1" MinWidth="250" Padding="14,7" CornerRadius="6"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind ViewModel.PageSummary, Mode=OneWay}"
                                       HorizontalAlignment="Center" FontSize="12" />
                        </Border>
                        <Button Grid.Column="2" Content="下一页" Padding="14,6"
                                IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                                Command="{x:Bind ViewModel.NextPageCommand, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Detail Panel -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Text="漫画详情" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <Border Width="120" Height="160" CornerRadius="8"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE8F1;" FontSize="30" Opacity="0.3"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{x:Bind ViewModel.SelectedCoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="WrapWholeWords" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="作者" Opacity="0.7" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.SelectedAuthor, Mode=OneWay}"
                                       TextWrapping="WrapWholeWords" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="站点" Opacity="0.7" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.SelectedSiteName, Mode=OneWay}" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="章数" Opacity="0.7" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.SelectedChapterSummary, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.SelectedLastChapter, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords" Opacity="0.8" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedContinueReading, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.SelectedContinueReading, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                                   TextWrapping="WrapWholeWords" Opacity="0.9" FontSize="12"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnReadClick">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                    <TextBlock Text="阅读漫画" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.OpenDirectoryCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="打开目录" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.OpenSourceLinkCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                                    <TextBlock Text="源链接" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.ExportCbzCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.IsExporting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7B7;" FontSize="14" />
                                    <TextBlock Text="导出CBZ" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.ToggleFavoriteCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE734;" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedFavoriteButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                    HorizontalAlignment="Stretch"
                                    Click="OnCleanupDuplicatesClick"
                                    Visibility="{x:Bind ViewModel.SelectedHasDuplicates, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="预览并清理重复目录" />
                                </StackPanel>
                            </Button>
                            <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                    Margin="0,4,0,0"
                                    Padding="10"
                                    CornerRadius="8"
                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                    BorderThickness="1">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="危险操作"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock Text="移入回收站后仍可恢复"
                                                   FontSize="11"
                                                   Opacity="0.78"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            MinWidth="104"
                                            VerticalAlignment="Center"
                                            Click="OnDeleteMangaClick"
                                            IsEnabled="{x:Bind ViewModel.CanDeleteSelectedManga, Mode=OneWay}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                            AutomationProperties.Name="删除本地漫画"
                                            AutomationProperties.HelpText="将选中漫画及其重复目录移入 Windows 回收站"
                                            ToolTipService.ToolTip="将本地漫画移入回收站">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14"
                                                      Visibility="{x:Bind ViewModel.IsDeleting, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <ProgressRing Width="14" Height="14"
                                                          IsActive="{x:Bind ViewModel.IsDeleting, Mode=OneWay}"
                                                          Visibility="{x:Bind ViewModel.IsDeleting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Text="{x:Bind ViewModel.DeleteButtonText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
