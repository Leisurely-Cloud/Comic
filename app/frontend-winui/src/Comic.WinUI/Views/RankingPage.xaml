<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Comic.WinUI.Views.RankingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="排行榜"
                       Style="{StaticResource TitleTextBlockStyle}"
                       FontSize="28" />
            <TextBlock Text="浏览各站点热门漫画排行榜"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.6" />
        </StackPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="站点:"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyTextBlockStyle}" />
            <ComboBox x:Name="SiteComboBox"
                      SelectedIndex="0"
                      MinWidth="120"
                      SelectionChanged="OnSiteSelectionChanged">
                <ComboBoxItem Content="包子漫画" Tag="baozimh" />
                <ComboBoxItem Content="拷贝漫画" Tag="mangacopy" />
                <ComboBoxItem Content="漫画柜" Tag="manhuagui" />
            </ComboBox>

            <TextBlock Text="分区:"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Style="{StaticResource BodyTextBlockStyle}" />
            <ComboBox x:Name="SectionComboBox"
                      ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedSectionItem, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      MinWidth="150" />
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="2">
            <!-- Loading -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="48" Height="48"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Error -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="Tomato" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="Tomato"
                           TextWrapping="Wrap" />
                <Button Content="重试"
                        Click="OnRetryClick" />
            </StackPanel>

            <!-- Ranking List -->
            <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView Grid.Row="0"
                          ItemsSource="{x:Bind ViewModel.RankingItems, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectionChanged="OnRankingItemSelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RankingItemViewModel"
                                      xmlns:vm="using:Comic.WinUI.ViewModels">
                            <Grid Padding="12" ColumnSpacing="12">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="下载此漫画"
                                                         Command="{x:Bind DownloadCommand}"
                                                         CommandParameter="{x:Bind Url}" />
                                        <MenuFlyoutItem Text="复制链接"
                                                         Click="OnCopyLinkClick"
                                                         Tag="{x:Bind Url}" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Source="{x:Bind CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                       Width="56" Height="78"
                                       Stretch="UniformToFill"
                                       CornerRadius="4" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind DetailSectionLabel, Mode=OneWay}"
                                               Opacity="0.6" FontSize="12" />
                                    <TextBlock Text="{x:Bind LatestChapter, Mode=OneWay}"
                                               Opacity="0.5" FontSize="12" />
                                    <TextBlock Text="{x:Bind DetailHint, Mode=OneWay}"
                                               Opacity="0.4" FontSize="11"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Command="{x:Bind DownloadCommand}"
                                        CommandParameter="{x:Bind Url}"
                                        ToolTipService.ToolTip="下载此漫画"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE896;" FontSize="16" />
                                </Button>
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind UpdateTime, Mode=OneWay}"
                                           Opacity="0.4" FontSize="12"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Load More -->
                <Button Grid.Row="1"
                        Content="加载更多"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Click="OnLoadMoreClick"
                        Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
