<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Comic.WinUI.Views.RankingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="24,20,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderCardBorderStyle}">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="排行榜" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="浏览禁漫天堂热门内容，点击漫画即可进入章节选择。"
                               Style="{StaticResource PageDescriptionTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="榜单分类" FontSize="12" Opacity="0.65" />
                    <ComboBox x:Name="SectionComboBox"
                              ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedSectionItem, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="170" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
        <Grid>
            <!-- Loading -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="48" Height="48" />
                <TextBlock Text="正在加载排行榜..."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Opacity="0.7"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Error -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" />
                <Button Content="重试"
                        Click="OnRetryClick" />
            </StackPanel>

            <!-- Ranking List -->
            <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Empty State -->
                <StackPanel Grid.Row="0"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE8A3;" FontSize="48" Opacity="0.5"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="暂无排行榜数据"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ListView Grid.Row="0"
                          ItemsSource="{x:Bind ViewModel.RankingItems, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnRankingItemClick"
                          Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RankingItemViewModel"
                                      xmlns:vm="using:Comic.WinUI.ViewModels">
                            <Grid Padding="16,14" MinHeight="112" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="4" Width="72" Height="96">
                                    <Image Source="{x:Bind CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                           Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               FontSize="16"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind LatestChapter, Mode=OneWay}"
                                               Opacity="0.6" FontSize="12" />
                                    <TextBlock Text="{x:Bind DetailHint, Mode=OneWay}"
                                               Opacity="0.6" FontSize="11"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind UpdateTime, Mode=OneWay}"
                                               Opacity="0.6" FontSize="12"
                                               HorizontalAlignment="Right" />
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="选择章节"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="12" />
                                        <FontIcon Glyph="&#xE76C;" FontSize="11"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Load More -->
                <Button Grid.Row="1"
                        Content="加载更多"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0"
                        Click="OnLoadMoreClick"
                        Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Page>
