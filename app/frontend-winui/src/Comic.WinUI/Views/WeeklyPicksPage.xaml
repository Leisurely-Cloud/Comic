<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Comic.WinUI.Views.WeeklyPicksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Padding="24,20,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderCardBorderStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="每周必看" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="浏览 JM 官方每周精选，点击作品即可进入章节选择。"
                               Style="{StaticResource PageDescriptionTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="推荐期数" FontSize="12" Opacity="0.65" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.Issues, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedIssue, Mode=TwoWay}"
                              DisplayMemberPath="Title" MinWidth="245" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="作品类型" FontSize="12" Opacity="0.65" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.Types, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedType, Mode=TwoWay}"
                              DisplayMemberPath="Title" MinWidth="130" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="4">
                    <TextBlock Text="内容分类" FontSize="12" Opacity="0.65" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                              DisplayMemberPath="Title" MinWidth="130" />
                </StackPanel>
                <Button Grid.Column="4" VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="刷新官方数据">
                    <FontIcon Glyph="&#xE72C;" />
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="48" Height="48" />
                    <TextBlock Text="正在加载官方每周推荐..." Opacity="0.7" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                    <Button Content="重试" Click="OnRetryClick" />
                </StackPanel>

                <Grid Visibility="{x:Bind ViewModel.CanShowContent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="16,12,16,4"
                               Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}"
                               FontSize="12" Opacity="0.6" />

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                                Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE8F1;" FontSize="48" Opacity="0.45" />
                        <TextBlock Text="本期暂无该类型作品" Opacity="0.7" />
                    </StackPanel>

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="OnItemClick"
                              Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WeeklyPickItemViewModel"
                                          xmlns:vm="using:Comic.WinUI.ViewModels">
                                <Grid Padding="16,14" MinHeight="126" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="5" Width="78" Height="104">
                                        <Image Source="{x:Bind CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       FontSize="16" TextTrimming="CharacterEllipsis" />
                                            <Border Padding="7,2" CornerRadius="9"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    Visibility="{x:Bind HasCategory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind CategoryDisplay, Mode=OneWay}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind AuthorDisplay, Mode=OneWay}" Opacity="0.65" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                   Visibility="{x:Bind AuthorDisplay, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" Opacity="0.58" FontSize="12"
                                                   TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="8">
                                        <TextBlock Text="{x:Bind UpdateTime, Mode=OneWay}" Opacity="0.58" FontSize="12"
                                                   HorizontalAlignment="Right" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="选择章节" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       FontWeight="SemiBold" FontSize="12" />
                                            <FontIcon Glyph="&#xE76C;" FontSize="11"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
