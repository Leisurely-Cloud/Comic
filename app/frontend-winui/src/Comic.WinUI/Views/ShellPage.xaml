<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Comic.WinUI.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <NavigationView x:Name="AppNavigationView"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Left"
                    ItemInvoked="OnNavigationItemInvoked"
                    OpenPaneLength="200">
        <NavigationView.Header>
            <Border Padding="20,14" Margin="0,0,0,4" CornerRadius="0,0,12,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE728;" FontSize="28"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="漫画下载器"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Padding="6,2" CornerRadius="4"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <TextBlock Text="{x:Bind ViewModel.BackendStatus, Mode=OneWay}"
                                           FontSize="12" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.StorageRoot, Mode=OneWay}"
                                       Opacity="0.5" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="400" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.EnsureBackendRunningCommand, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="启动后端" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.StopBackendCommand, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                <TextBlock Text="停止后端" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </NavigationView.Header>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="搜索下载" Tag="download">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE721;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="本地漫画库" Tag="library">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8D1;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="应用设置" Tag="settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <Border Margin="12,0,12,12"
                    Visibility="{x:Bind ViewModel.HasShellError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource CompactCardBorderStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE783;" Foreground="Tomato" VerticalAlignment="Center" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.ShellErrorSummary, Mode=OneWay}"
                               Foreground="Tomato" TextWrapping="WrapWholeWords" FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </NavigationView.PaneFooter>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
