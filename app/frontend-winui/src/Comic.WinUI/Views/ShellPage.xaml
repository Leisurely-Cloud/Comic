<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Comic.WinUI.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <NavigationView x:Name="AppNavigationView"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="Auto"
                    IsPaneOpen="{x:Bind ViewModel.IsNavigationPaneOpen, Mode=TwoWay}"
                    IsPaneToggleButtonVisible="False"
                    AlwaysShowHeader="False"
                    ItemInvoked="OnNavigationItemInvoked"
                    CompactPaneLength="56"
                    OpenPaneLength="224">
        <NavigationView.PaneHeader>
            <Grid Height="64" Margin="12,0,8,8">
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="禁漫下载器" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="搜索 · 下载 · 阅读" FontSize="11" Opacity="0.58" />
                </StackPanel>
            </Grid>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="找漫画" Tag="download" IsSelected="True">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE721;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="排行榜" Tag="ranking">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8A3;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="我的书库" Tag="library">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8D1;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="设置" Tag="settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <StackPanel Margin="8,0,8,12" Spacing="8">
                <Border Visibility="{x:Bind ViewModel.HasShellError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Style="{StaticResource CompactCardBorderStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE783;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.ShellErrorSummary, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="WrapWholeWords" FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </NavigationView.PaneFooter>

        <Frame x:Name="ContentFrame"
               Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
    </NavigationView>
</Page>
