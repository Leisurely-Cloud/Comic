<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Comic.WinUI.Views.UpdateCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Comic.WinUI.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="24,20,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderCardBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="追更中心" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               Style="{StaticResource PageDescriptionTextBlockStyle}" />
                </StackPanel>
                <Button Grid.Column="1" Height="40" Padding="14,0"
                        Command="{x:Bind ViewModel.OpenDownloadsCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock Text="下载任务" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Height="40" Padding="14,0"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                        Command="{x:Bind ViewModel.CheckUpdatesCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="检查更新" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8,2,8,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}"
                                   FontSize="12" Opacity="0.65" />
                        <Button Grid.Column="1" Content="全选" Padding="12,6"
                                Command="{x:Bind ViewModel.SelectAllCommand, Mode=OneWay}" />
                        <Button Grid.Column="2" Content="清空" Padding="12,6"
                                Command="{x:Bind ViewModel.ClearSelectionCommand, Mode=OneWay}" />
                        <Button Grid.Column="3" Padding="14,6"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanDownloadSelected, Mode=OneWay}"
                                Command="{x:Bind ViewModel.DownloadSelectedCommand, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <ProgressRing Width="16" Height="16"
                                              IsActive="{x:Bind ViewModel.IsDownloading, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <FontIcon Glyph="&#xE896;" FontSize="14"
                                          Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock Text="补下载所选" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:UpdateCenterItemViewModel">
                                <Grid Padding="12,10" MinHeight="124" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              IsEnabled="{x:Bind IsQueued, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                                    <Border Grid.Column="1" Width="76" Height="102" CornerRadius="6">
                                        <Image Source="{x:Bind CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="5">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind AuthorText, Mode=OneWay}" FontSize="12" Opacity="0.62"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Padding="7,2" CornerRadius="9"
                                                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind ChapterCountText, Mode=OneWay}" FontSize="11"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind LatestChapterText, Mode=OneWay}" FontSize="12" Opacity="0.62"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind MissingChapterText, Mode=OneWay}" FontSize="12" Opacity="0.66"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{x:Bind StatusText, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="8">
                                        <Button Content="查看详情" Padding="12,6"
                                                Command="{x:Bind OpenMangaCommand, Mode=OneWay}" />
                                        <Button Padding="12,6" Style="{StaticResource AccentButtonStyle}"
                                                IsEnabled="{x:Bind CanDownload, Mode=OneWay}"
                                                Command="{x:Bind DownloadCommand, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                                <TextBlock Text="补下载" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            Visibility="{x:Bind ViewModel.ShowInitialState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE895;" FontSize="52" Opacity="0.42" HorizontalAlignment="Center" />
                    <TextBlock Text="检查本地漫画是否发布了新章节" Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="只会读取本地书库并访问对应作品资料，不会自动开始下载。"
                               Style="{StaticResource PageDescriptionTextBlockStyle}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <Button Content="开始检查" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.CheckUpdatesCommand, Mode=OneWay}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE73E;" FontSize="52" Opacity="0.42" HorizontalAlignment="Center" />
                    <TextBlock Text="当前没有需要补下载的新章节" Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="稍后可以再次检查。" Style="{StaticResource PageDescriptionTextBlockStyle}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <ProgressRing IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" />
                        <TextBlock Text="正在逐部检查章节..." Opacity="0.7"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         VerticalAlignment="Top" Margin="8" />
            </Grid>
        </Border>
    </Grid>
</Page>
