<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Comic.WinUI.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="OnKeyDown"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar: back + manga title -->
        <Border Grid.Row="0" Padding="16,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="OnBackClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock Text="返回" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MangaTitle, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <ComboBox Width="110" SelectedIndex="{x:Bind ViewModel.ReaderModeIndex, Mode=TwoWay}" SelectionChanged="OnReaderModeChanged">
                        <ComboBoxItem Content="单页" />
                        <ComboBoxItem Content="双页" />
                        <ComboBoxItem Content="条漫" />
                    </ComboBox>
                    <ToggleButton Content="从右向左" IsChecked="{x:Bind ViewModel.IsRightToLeft, Mode=TwoWay}"
                                  Visibility="{x:Bind ViewModel.IsStripMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <Button Content="快捷键" Click="OnShortcutSettingsClick" />
                    <Button Content="全屏" Click="OnFullscreenClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chapter bar: chapter selector + page info -->
        <Border Grid.Row="1" Padding="16,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="章节"
                           VerticalAlignment="Center" Opacity="0.7" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedChapter, Mode=TwoWay}"
                          DisplayMemberPath="Title"
                          SelectionChanged="OnChapterSelectionChanged"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Stretch"
                          MinWidth="200" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind ViewModel.IsStripMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Width="34" Padding="0"
                            Content="−"
                            Click="OnStripZoomOutClick"
                            IsEnabled="{x:Bind ViewModel.CanZoomStripOut, Mode=OneWay}"
                            ToolTipService.ToolTip="缩小（Ctrl + 滚轮向下）" />
                    <Button MinWidth="62" Padding="8,4"
                            Content="{x:Bind ViewModel.StripZoomText, Mode=OneWay}"
                            Click="OnStripZoomResetClick"
                            ToolTipService.ToolTip="适应阅读区宽度（100%）" />
                    <Button Width="34" Padding="0"
                            Content="+"
                            Click="OnStripZoomInClick"
                            IsEnabled="{x:Bind ViewModel.CanZoomStripIn, Mode=OneWay}"
                            ToolTipService.ToolTip="放大（Ctrl + 滚轮向上）" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind ViewModel.IsStripMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Button Width="34" Padding="0"
                            Content="−"
                            Click="OnPagedZoomOutClick"
                            IsEnabled="{x:Bind ViewModel.CanZoomPagedOut, Mode=OneWay}"
                            ToolTipService.ToolTip="缩小（Ctrl + 滚轮向下）" />
                    <Button MinWidth="62" Padding="8,4"
                            Content="{x:Bind ViewModel.PagedZoomText, Mode=OneWay}"
                            Click="OnPagedZoomResetClick"
                            ToolTipService.ToolTip="适应阅读区（100%）" />
                    <Button Width="34" Padding="0"
                            Content="+"
                            Click="OnPagedZoomInClick"
                            IsEnabled="{x:Bind ViewModel.CanZoomPagedIn, Mode=OneWay}"
                            ToolTipService.ToolTip="放大（Ctrl + 滚轮向上）" />
                </StackPanel>
                <Button Grid.Column="3" Content="上一章"
                        Click="OnPreviousChapterClick"
                        IsEnabled="{x:Bind ViewModel.HasPreviousChapter, Mode=OneWay}" />
                <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.ChapterProgress, Mode=OneWay}"
                           VerticalAlignment="Center" Opacity="0.8" MinWidth="50"
                           TextAlignment="Center" />
                <Button Grid.Column="5" Content="下一章"
                        Click="OnNextChapterClick"
                        IsEnabled="{x:Bind ViewModel.HasNextChapter, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- Image viewer -->
        <Grid Grid.Row="2"
              Visibility="{x:Bind ViewModel.IsStripMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" VerticalAlignment="Center" Margin="8,0,0,0"
                    Click="OnPreviousImageClick"
                    Visibility="{x:Bind ViewModel.HasPreviousImageOrChapter, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE76B;" FontSize="24" />
            </Button>

            <ScrollViewer x:Name="PagedScrollViewer" Grid.Column="1"
                          HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ZoomMode="Disabled"
                          SizeChanged="OnPagedViewportSizeChanged">
                <Grid Tapped="OnImageAreaTapped" Background="Transparent"
                      FlowDirection="{x:Bind ViewModel.PageFlowDirection, Mode=OneWay}" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="PagedImage" Grid.Column="0" Grid.ColumnSpan="2"
                           Source="{x:Bind ViewModel.CurrentImage, Mode=OneWay}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center" ImageOpened="OnPagedImageOpened" />
                    <Image x:Name="SecondaryPagedImage" Grid.Column="1"
                           Source="{x:Bind ViewModel.SecondaryImage, Mode=OneWay}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center" ImageOpened="OnSecondaryPagedImageOpened"
                           Visibility="{x:Bind ViewModel.IsDoublePage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </ScrollViewer>

            <Button Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                    Click="OnNextImageClick"
                    Visibility="{x:Bind ViewModel.HasNextImageOrChapter, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE76C;" FontSize="24" />
            </Button>

        </Grid>

        <!-- Strip reader: virtualized continuous vertical images -->
        <ScrollViewer x:Name="StripScrollViewer"
                      Grid.Row="2"
                      HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto"
                      SizeChanged="OnStripViewportSizeChanged"
                      ViewChanged="OnStripViewChanged"
                      Visibility="{x:Bind ViewModel.IsStripMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsRepeater x:Name="StripImageRepeater"
                           HorizontalAlignment="Center"
                           ItemsSource="{x:Bind ViewModel.StripImages, Mode=OneWay}"
                           ElementPrepared="OnStripElementPrepared"
                           ElementClearing="OnStripElementClearing">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="0" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ReaderStripImageItemViewModel"
                                  xmlns:viewModels="using:Comic.WinUI.ViewModels">
                        <Grid MinHeight="480"
                              HorizontalAlignment="Stretch">
                            <Image Source="{x:Bind Image, Mode=OneWay}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Top"
                                   ImageOpened="OnStripImageOpened" />
                            <ProgressRing Width="40" Height="40"
                                          IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="{x:Bind IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    Padding="8,4"
                                    CornerRadius="6"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <TextBlock Text="{x:Bind PageLabel}"
                                           FontSize="11"
                                           Opacity="0.7" />
                            </Border>
                            <Border Margin="24"
                                    Padding="12"
                                    CornerRadius="6"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Bind Error, Mode=OneWay}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               MaxWidth="680" />
                                    <Button Content="重试本页"
                                            HorizontalAlignment="Center"
                                            Click="OnRetryStripImageClick"
                                            AutomationProperties.Name="重新加载当前图片" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Loading indicator shared by both reader modes -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="48" Height="48"
                          HorizontalAlignment="Center" />
            <TextBlock Text="正在加载..."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.7"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Bottom bar: page navigation -->
        <Border Grid.Row="3" Padding="16,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{x:Bind ViewModel.IsStripMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SelectedChapter.Title, Mode=OneWay}"
                           VerticalAlignment="Center" Opacity="0.7"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                <Button Grid.Column="1" Content="上一张" Click="OnPreviousImageClick"
                        IsEnabled="{x:Bind ViewModel.HasPreviousImageOrChapter, Mode=OneWay}" />
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PageIndicator, Mode=OneWay}"
                           VerticalAlignment="Center" MinWidth="70" TextAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Button Grid.Column="3" Content="下一张" Click="OnNextImageClick"
                        IsEnabled="{x:Bind ViewModel.HasNextImageOrChapter, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- Error display -->
        <Border Grid.Row="2" Margin="16"
                Visibility="{x:Bind ViewModel.PageError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="8" Padding="16,10">
            <TextBlock Text="{x:Bind ViewModel.PageError, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Page>
