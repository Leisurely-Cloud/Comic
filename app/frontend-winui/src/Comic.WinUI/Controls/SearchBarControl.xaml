<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comic.WinUI.Controls.SearchBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource HeaderCardBorderStyle}">
        <StackPanel Spacing="14">
            <!-- Title + Backend buttons -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="搜索下载" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="选择站点，输入漫画名称搜索，选择后开始下载。"
                               Opacity="0.6" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.EnsureBackendRunningCommand, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="启动后端" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.RefreshBackendCommand, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <!-- Search inputs -->
            <Grid ColumnSpacing="12" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Header="站点"
                          VerticalAlignment="Bottom"
                          ItemsSource="{x:Bind ViewModel.SiteOptions, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedSite, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="漫画名称"
                         PlaceholderText="输入关键词搜索..."
                         Text="{x:Bind ViewModel.SearchKeyword, Mode=TwoWay}" />
                <Button Grid.Column="2" VerticalAlignment="Bottom" MinWidth="90"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SearchCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock Text="搜索" />
                    </StackPanel>
                </Button>
            </Grid>
            <!-- Error message -->
            <TextBlock Text="{x:Bind ViewModel.PageError, Mode=OneWay}"
                       Foreground="Tomato" TextWrapping="WrapWholeWords" />
        </StackPanel>
    </Border>
</UserControl>
