<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comic.WinUI.Controls.SearchBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Comic.WinUI.Models"
    mc:Ignorable="d">

    <Border Style="{StaticResource HeaderCardBorderStyle}">
        <StackPanel Spacing="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="搜索漫画" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <TextBlock Text="支持 JM 编号、链接与关键词"
                               Style="{StaticResource PageDescriptionTextBlockStyle}" />
                </StackPanel>
                <AutoSuggestBox Grid.Column="1"
                         x:Name="SearchSuggestBox"
                         PlaceholderText="输入 JM 编号、链接或名称，按 Enter 搜索"
                         Text="{x:Bind ViewModel.SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ItemsSource="{x:Bind ViewModel.SearchHistory, Mode=OneWay}"
                         TextChanged="OnSearchTextChanged"
                         SuggestionChosen="OnSuggestionChosen"
                         QuerySubmitted="OnQuerySubmitted"
                         GotFocus="OnSearchBoxGotFocus"
                         KeyDown="OnSearchKeyDown">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchHistoryEntry">
                            <Grid Padding="0,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE81C;" FontSize="14" Opacity="0.6"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Keyword, Mode=OneWay}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SiteName, Mode=OneWay}"
                                           Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3"
                                           Opacity="0.6" FontSize="11" VerticalAlignment="Center">
                                    <Run Text="{x:Bind ResultCount, Mode=OneWay}" /><Run Text="条结果" />
                                </TextBlock>
                                <Button Grid.Column="4"
                                        Width="30" Height="28" Padding="0"
                                        Margin="6,0,0,0"
                                        IsTabStop="False"
                                        ToolTipService.ToolTip="删除这条历史记录"
                                        Click="OnRemoveHistoryClick">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <Button Grid.Column="2"
                        Width="40" Height="32" Padding="0"
                        ToolTipService.ToolTip="清除搜索历史"
                        Visibility="{x:Bind ViewModel.HasSearchHistory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Command="{x:Bind ViewModel.ClearSearchHistoryCommand, Mode=OneWay}">
                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                </Button>
                <Button Grid.Column="3" MinWidth="96"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SearchCommand, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock Text="搜索" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border Padding="10,7" CornerRadius="6"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    Visibility="{x:Bind ViewModel.PageError, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE783;" FontSize="13"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.PageError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
