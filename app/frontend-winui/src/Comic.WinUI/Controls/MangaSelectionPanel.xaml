<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comic.WinUI.Controls.MangaSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Comic.WinUI.ViewModels"
    mc:Ignorable="d">

    <Border Style="{StaticResource CardBorderStyle}"
            PointerWheelChanged="OnPanelPointerWheelChanged">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="0">
                <TextBlock Text="选择章节" Style="{StaticResource SectionHeaderTextBlockStyle}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Width="68" Height="68" CornerRadius="34"
                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE8A5;" FontSize="30" Opacity="0.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="请先从左侧选择一部漫画"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="章节加载完成后，可在这里选择并创建下载任务。"
                               Style="{StaticResource PageDescriptionTextBlockStyle}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <Grid Visibility="{x:Bind ViewModel.ShowMangaContent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Width="112" Height="150" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Click="OnCoverClick"
                                ToolTipService.ToolTip="点击查看高清封面">
                            <Border Width="112" Height="150" CornerRadius="8"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <Grid>
                                    <FontIcon Glyph="&#xE8A5;" FontSize="30" Opacity="0.25"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{x:Bind ViewModel.CurrentMangaCoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                           Stretch="UniformToFill" />
                                    <Border VerticalAlignment="Bottom" Padding="8,5"
                                            Background="#99000000">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                                            <FontIcon Glyph="&#xE8A3;" FontSize="11" Foreground="White" />
                                            <TextBlock Text="查看大图" FontSize="11" Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind ViewModel.CurrentMangaTitle, Mode=OneWay}"
                                       FontSize="16" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentMangaIdentityText, Mode=OneWay}"
                                       FontSize="12" Opacity="0.55" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentMangaAuthorText, Mode=OneWay}"
                                       FontSize="12" Opacity="0.72" TextTrimming="CharacterEllipsis" MaxLines="1"
                                       Visibility="{x:Bind ViewModel.CurrentMangaAuthorText, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentMangaStatsText, Mode=OneWay}"
                                       FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentMangaAddedAtText, Mode=OneWay}"
                                       FontSize="12" Opacity="0.58"
                                       Visibility="{x:Bind ViewModel.CurrentMangaAddedAtText, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <Expander Grid.Row="1" Header="作品详情" IsExpanded="True"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Visibility="{x:Bind ViewModel.HasMangaDetails, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ScrollViewer MaxHeight="150"
                                      VerticalScrollMode="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Padding="0,4,8,8" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.CurrentMangaTagsText, Mode=OneWay}"
                                           FontSize="12" Opacity="0.72" TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.CurrentMangaTagsText, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind ViewModel.CurrentMangaDescription, Mode=OneWay}"
                                           FontSize="12" Opacity="0.68" TextWrapping="WrapWholeWords"
                                           IsTextSelectionEnabled="True"
                                           Visibility="{x:Bind ViewModel.CurrentMangaDescription, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7"
                                    VerticalAlignment="Center">
                            <TextBlock Text="章节" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.ChapterSelectionSummary, Mode=OneWay}"
                                       FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="全选"
                                Padding="10,4"
                                Command="{x:Bind ViewModel.SelectAllChaptersCommand, Mode=OneWay}" />
                        <Button Grid.Column="2" Content="清空"
                                Padding="10,4"
                                Command="{x:Bind ViewModel.DeselectAllChaptersCommand, Mode=OneWay}" />
                    </Grid>

                    <Border Grid.Row="3" MinHeight="88" CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <ListView x:Name="ChapterListView"
                                  ItemsSource="{x:Bind ViewModel.AvailableChapters, Mode=OneWay}"
                                  SelectionMode="None"
                                  ScrollViewer.VerticalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.IsVerticalRailEnabled="True"
                                  Visibility="{x:Bind ViewModel.ShowChapterSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ChapterItemViewModel">
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              Content="{x:Bind Title, Mode=OneWay}"
                                              Padding="8,3"
                                              HorizontalAlignment="Stretch" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <Grid Grid.Row="4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="无需下载，点开即读"
                                   FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
                        <Button Grid.Column="1" MinWidth="108" Padding="12,6"
                                IsEnabled="{x:Bind ViewModel.CanToggleJmFavorite, Mode=OneWay}"
                                Click="OnFavoriteClick">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="{x:Bind ViewModel.JmFavoriteButtonGlyph, Mode=OneWay}" FontSize="14" />
                                <TextBlock Text="{x:Bind ViewModel.JmFavoriteButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" MinWidth="120"
                                Padding="14,6"
                                IsEnabled="{x:Bind ViewModel.HasManga, Mode=OneWay}"
                                Click="OnOnlineReadClick">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                                <TextBlock Text="在线阅读" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" MinWidth="150"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanStartDownload, Mode=OneWay}"
                                Click="OnStartDownloadClick">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="{x:Bind ViewModel.DownloadButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.IsResolving, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <ProgressRing IsActive="True" Width="36" Height="36" />
                        <TextBlock Text="正在获取漫画详情和章节..."
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
