<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comic.WinUI.Controls.MangaSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Comic.WinUI.ViewModels"
    mc:Ignorable="d">

    <Border Style="{StaticResource CardBorderStyle}"
            PointerWheelChanged="OnPanelPointerWheelChanged">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="0">
                <TextBlock Text="选择章节" Style="{StaticResource SectionHeaderTextBlockStyle}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            Visibility="{x:Bind ViewModel.HasManga, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Border Width="68" Height="68" CornerRadius="34"
                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE8A5;" FontSize="30" Opacity="0.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="请先从左侧选择一部漫画"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="章节加载完成后，可在这里选择并创建下载任务。"
                               Style="{StaticResource PageDescriptionTextBlockStyle}"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <Grid Visibility="{x:Bind ViewModel.HasManga, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="68" Height="88" CornerRadius="8"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE8A5;" FontSize="26" Opacity="0.25"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{x:Bind ViewModel.CurrentMangaCoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CurrentMangaTitle, Mode=OneWay}"
                                       FontSize="16" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentMangaLatestChapter, Mode=OneWay}"
                                       FontSize="12" Opacity="0.7"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentMangaDetailHint, Mode=OneWay}"
                                       FontSize="12" Opacity="0.58"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7"
                                    VerticalAlignment="Center">
                            <TextBlock Text="章节" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.ChapterSelectionSummary, Mode=OneWay}"
                                       FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="全选"
                                Padding="10,4"
                                Command="{x:Bind ViewModel.SelectAllChaptersCommand, Mode=OneWay}" />
                        <Button Grid.Column="2" Content="清空"
                                Padding="10,4"
                                Command="{x:Bind ViewModel.DeselectAllChaptersCommand, Mode=OneWay}" />
                    </Grid>

                    <Border Grid.Row="2" MinHeight="88" CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <ListView x:Name="ChapterListView"
                                  ItemsSource="{x:Bind ViewModel.AvailableChapters, Mode=OneWay}"
                                  SelectionMode="None"
                                  ScrollViewer.VerticalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.IsVerticalRailEnabled="True"
                                  Visibility="{x:Bind ViewModel.ShowChapterSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ChapterItemViewModel">
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              Content="{x:Bind Title, Mode=OneWay}"
                                              Padding="8,3"
                                              HorizontalAlignment="Stretch" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <Grid Grid.Row="3">
                        <Button MinWidth="150"
                                HorizontalAlignment="Right"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanStartDownload, Mode=OneWay}"
                                Click="OnStartDownloadClick">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="{x:Bind ViewModel.DownloadButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.IsResolving, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <ProgressRing IsActive="True" Width="36" Height="36" />
                        <TextBlock Text="正在获取漫画详情和章节..."
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
