<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comic.WinUI.Controls.SearchResultsList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Comic.WinUI.ViewModels"
    mc:Ignorable="d">

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                <TextBlock Text="搜索结果" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.SearchStatusText, Mode=OneWay}"
                           Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Visibility="{x:Bind ViewModel.IsSearching, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                            Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                            HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock Text="搜索中..." Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedSearchResult, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:SearchResultItemViewModel">
                            <Grid Padding="8,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="48" Height="64" CornerRadius="4"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind CoverUrl}" DecodePixelWidth="48" />
                                        </Image.Source>
                                    </Image>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind LatestChapter}" Opacity="0.6" FontSize="12" />
                                        <TextBlock Text="{x:Bind UpdateTime}" Opacity="0.4" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" Opacity="0.3"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Border>
</UserControl>
