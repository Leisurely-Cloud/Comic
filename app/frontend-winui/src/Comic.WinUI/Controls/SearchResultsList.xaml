<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comic.WinUI.Controls.SearchResultsList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Comic.WinUI.Models"
    xmlns:viewModels="using:Comic.WinUI.ViewModels"
    mc:Ignorable="d">

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="200" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="搜索结果"
                           Style="{StaticResource SectionHeaderTextBlockStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SearchStatusText, Mode=OneWay}"
                           Opacity="0.7" VerticalAlignment="Center" />
                <Grid Grid.Column="2">
                    <Button Content="加载更多" Padding="10,4"
                            Visibility="{x:Bind ViewModel.CanLoadMoreSearchResults, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                            Command="{x:Bind ViewModel.LoadMoreSearchResultsCommand, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.IsLoadingMore, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <ProgressRing IsActive="True" Width="14" Height="14" />
                        <TextBlock Text="加载中..." FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Visibility="{x:Bind ViewModel.IsSearching, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                            Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                            HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock Text="搜索中..." Opacity="0.8" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Empty State -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            Visibility="{x:Bind ViewModel.HasSearchResults, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE721;" FontSize="48" Opacity="0.5"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="还没有搜索结果"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Opacity="0.7"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="先在上方输入 JM 编号、链接或漫画名称"
                               FontSize="12" Opacity="0.55"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedSearchResult, Mode=TwoWay}"
                          SelectionMode="Single"
                          Visibility="{x:Bind ViewModel.HasSearchResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:SearchResultItemViewModel">
                            <Grid Padding="6,7" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="58" CornerRadius="4"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind CoverUrl}" DecodePixelWidth="44" />
                                        </Image.Source>
                                    </Image>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextWrapping="WrapWholeWords"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Author, Mode=OneWay}"
                                                   Visibility="{x:Bind Author, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                                                   Opacity="0.7" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                        <TextBlock Text="{x:Bind UpdateTime, Mode=OneWay}" Opacity="0.6" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" Opacity="0.5"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Row="2"
                    Padding="0,12,0,0"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.HasManga, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="漫画评论" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.CommentSummary, Mode=OneWay}"
                                       FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                        </StackPanel>
                        <ProgressRing Grid.Column="1" Width="16" Height="16"
                                      IsActive="{x:Bind ViewModel.IsLoadingComments, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsLoadingComments, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Grid.Column="2"
                                Padding="8,4"
                                Command="{x:Bind ViewModel.RefreshCommentsCommand, Mode=OneWay}"
                                ToolTipService.ToolTip="刷新评论">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    Visibility="{x:Bind ViewModel.IsLoadingComments, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="正在加载评论..." FontSize="12" Opacity="0.65" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                    Visibility="{x:Bind ViewModel.HasCommentsError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE783;" FontSize="26" Opacity="0.6" />
                            <TextBlock Text="{x:Bind ViewModel.CommentsError, Mode=OneWay}"
                                       FontSize="12" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button Content="重试" Padding="12,5"
                                    Command="{x:Bind ViewModel.RefreshCommentsCommand, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    Visibility="{x:Bind ViewModel.ShowCommentsEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE90A;" FontSize="30" Opacity="0.42" />
                            <TextBlock Text="这部漫画暂时没有评论" FontSize="12" Opacity="0.62" />
                        </StackPanel>

                        <ListView ItemsSource="{x:Bind ViewModel.Comments, Mode=OneWay}"
                                  SelectionMode="None"
                                  Visibility="{x:Bind ViewModel.ShowCommentsList, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:MangaCommentDto">
                                    <Grid Padding="4,8" RowSpacing="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind AuthorDisplay}" FontWeight="SemiBold" FontSize="13" />
                                                <Border Padding="5,1" CornerRadius="4"
                                                        BorderThickness="1"
                                                        BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        Visibility="{x:Bind IsSpoiler, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="剧透" FontSize="10"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind CreatedAt}"
                                                       FontSize="11" Opacity="0.5" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{x:Bind Content}"
                                                   FontSize="13" TextWrapping="WrapWholeWords" />
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4"
                                                    Visibility="{x:Bind HasLikes, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <FontIcon Glyph="&#xE8E1;" FontSize="11" Opacity="0.55" />
                                            <TextBlock Text="{x:Bind LikesText}" FontSize="11" Opacity="0.55" />
                                        </StackPanel>
                                        <Border Grid.Row="3" Margin="6,2,0,0" Padding="9,5"
                                                CornerRadius="4"
                                                BorderThickness="2,0,0,0"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                Visibility="{x:Bind HasReplies, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl ItemsSource="{x:Bind Replies}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:MangaCommentDto">
                                                        <StackPanel Margin="0,3" Spacing="2">
                                                            <TextBlock FontSize="12" TextWrapping="WrapWholeWords">
                                                                <Run Text="{x:Bind AuthorDisplay}" FontWeight="SemiBold" />
                                                                <Run Text="：" />
                                                                <Run Text="{x:Bind Content}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{x:Bind CreatedAt}" FontSize="10" Opacity="0.45" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid Grid.Row="2"
                          HorizontalAlignment="Center"
                          ColumnSpacing="8"
                          Visibility="{x:Bind ViewModel.HasComments, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Padding="12,5"
                                IsEnabled="{x:Bind ViewModel.CanGoPreviousComments, Mode=OneWay}"
                                Command="{x:Bind ViewModel.PreviousCommentsPageCommand, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE76B;" FontSize="10" />
                                <TextBlock Text="上一页" />
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="1"
                                MinWidth="108"
                                Padding="12,6"
                                CornerRadius="6"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind ViewModel.CommentPageSummary, Mode=OneWay}"
                                       FontSize="12" Opacity="0.72"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <Button Grid.Column="2"
                                Padding="12,5"
                                IsEnabled="{x:Bind ViewModel.CanGoNextComments, Mode=OneWay}"
                                Command="{x:Bind ViewModel.NextCommentsPageCommand, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="下一页" />
                                <FontIcon Glyph="&#xE76C;" FontSize="10" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
