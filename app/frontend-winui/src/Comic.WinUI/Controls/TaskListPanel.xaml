<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comic.WinUI.Controls.TaskListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Comic.WinUI.ViewModels"
    xmlns:models="using:Comic.WinUI.Models"
    mc:Ignorable="d">

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="下载任务"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TaskCountSummary, Mode=OneWay}"
                           Opacity="0.6" VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1" Margin="0,8,0,0"
                    Style="{StaticResource CompactCardBorderStyle}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.CurrentTask.StatusText, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.CurrentTask.ProgressText, Mode=OneWay}"
                                   Opacity="0.7" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{x:Bind ViewModel.CurrentTask.Progress, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <ListView Grid.Row="2" Margin="0,8,0,0"
                      ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentTask, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DownloadTaskItemViewModel">
                        <Grid Padding="4,6" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                <TextBlock Text="{x:Bind LatestLogMessage}" Opacity="0.5"
                                           TextTrimming="CharacterEllipsis" FontSize="11" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Status}"
                                       VerticalAlignment="Center" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ProgressText}"
                                       VerticalAlignment="Center" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- Log Panel -->
            <Border Grid.Row="3" Margin="0,8,0,0"
                    Style="{StaticResource CompactCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="实时日志"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentTask.Status, Mode=OneWay}"
                                   Opacity="0.6" FontSize="12" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentTask.Logs, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DownloadLogEntry">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                        <TextBlock Text="{x:Bind Time}" Opacity="0.5" FontSize="11" MinWidth="70" />
                                        <TextBlock Text="{x:Bind Tag}" Opacity="0.6" FontSize="11" MinWidth="36" />
                                        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
