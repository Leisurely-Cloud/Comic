<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Comic.WinUI.Controls.MangaDetailCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Comic.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Manga Detail -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Text="漫画详情" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <!-- Empty state -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasManga, Converter={StaticResource InvertBoolToVisibilityConverter}, Mode=OneWay}"
                                    Padding="0,20" HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8F1;" FontSize="28" HorizontalAlignment="Center" Opacity="0.4" />
                            <TextBlock Text="搜索并选择一部漫画查看详情" Opacity="0.5" HorizontalAlignment="Center" />
                        </StackPanel>
                        <!-- Cover Image -->
                        <Border Height="120" CornerRadius="6" HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.HasManga, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Image Stretch="UniformToFill">
                                <Image.Source>
                                    <BitmapImage UriSource="{x:Bind ViewModel.CurrentManga.CoverUrl, Mode=OneWay}" DecodePixelHeight="120" />
                                </Image.Source>
                            </Image>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.CurrentManga.Title, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="WrapWholeWords" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="站点" Opacity="0.6" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentManga.SiteName, Mode=OneWay}" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最新" Opacity="0.6" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentManga.LatestChapter, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.CurrentManga.DetailHint, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords" Opacity="0.7" FontSize="12" />
                        <!-- Buttons: 2x2 grid -->
                        <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button x:Name="StartDownloadBtn" Grid.Row="0" Grid.Column="0"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.StartDownloadCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="开始下载" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PauseBtn" Grid.Row="0" Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.PauseCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE769;" FontSize="14" />
                                    <TextBlock Text="暂停" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ResumeBtn" Grid.Row="1" Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.ResumeCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="继续" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopBtn" Grid.Row="1" Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.StopCommand, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                    <TextBlock Text="停止" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <!-- Loading overlay -->
                <Grid Visibility="{x:Bind ViewModel.IsResolving, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Opacity="0.85">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <ProgressRing IsActive="True" Width="32" Height="32" />
                        <TextBlock Text="正在获取漫画详情..." Opacity="0.7" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Chapter Selection -->
        <Border Grid.Row="1" Margin="0,12,0,0"
                Visibility="{x:Bind ViewModel.ShowChapterSelection, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="章节选择"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.ChapterSelectionSummary, Mode=OneWay}"
                               Opacity="0.6" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button x:Name="SelectAllBtn" Command="{x:Bind ViewModel.SelectAllChaptersCommand, Mode=OneWay}" Padding="8,4">
                        <TextBlock Text="全选" FontSize="12" />
                    </Button>
                    <Button x:Name="DeselectAllBtn" Command="{x:Bind ViewModel.DeselectAllChaptersCommand, Mode=OneWay}" Padding="8,4">
                        <TextBlock Text="取消全选" FontSize="12" />
                    </Button>
                </StackPanel>
                <ScrollViewer Grid.Row="2" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableChapters, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ChapterItemViewModel">
                                <CheckBox Content="{x:Bind Title}"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
